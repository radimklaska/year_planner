// year-planner.klaska.net: an assets-only Worker serving the static site from the repo
// root (no build step). .assetsignore keeps the repo's own files (README, tests,
// tooling) out of the upload. The klaska.net zone injects the Cloudflare Web
// Analytics beacon automatically.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "year-planner",
  "compatibility_date": "2026-11-15",

  // Production is the custom domain only. Per-PR previews stay on workers.dev,
  // where Cloudflare adds X-Robots-Tag: noindex automatically.
  "workers_dev": false,
  "preview_urls": true,

  // Cloudflare owns this hostname's DNS record and certificate. A CI deploy
  // replaces any existing DNS record for it (the old GitHub Pages CNAME).
  "routes": [{ "pattern": "year-planner.klaska.net", "custom_domain": true }],

  // Workers Previews (`wrangler preview`, one per PR, see deploy.yml). Nothing to
  // configure for an assets-only Worker, but the block has to exist.
  "previews": {},

  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
